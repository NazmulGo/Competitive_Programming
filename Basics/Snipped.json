            "const int N = 100000000; ",
            "vector<int> mark((N >> 6) + 5);",
            "vector<int> primes;",
            "",
            "inline bool isComposite(int x) {",
            "    return mark[x >> 6] & (1 << ((x >> 1) & 31));",
            "}",
            "inline void setComposite(int x) {",
            "    mark[x >> 6] |= (1 << ((x >> 1) & 31));",
            "}",
            "bool isPrime(int n) {",
            "    if (n == 2) return true;",
            "    if (n < 2 || (n & 1) == 0) return false;",
            "    return !isComposite(n);",
            "}",
            "",
            "void bitwise_sieve() {",
            "    int limit = sqrt(N);",
            "",
            "    for (int i = 3; i <= limit; i += 2) {",
            "        if (!isComposite(i)) {",
            "            for (int j = i * i; j <= N; j += i << 1) setComposite(j);",
            "        }",
            "    }",
            "",
            "    primes.push_back(2);",
            "    for (int i = 3; i <= N; i += 2) {",
            "        if (!isComposite(i)) primes.push_back(i);",
